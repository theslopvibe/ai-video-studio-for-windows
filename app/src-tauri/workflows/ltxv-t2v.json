{
 "meta": {
  "id": "ltxv-t2v",
  "name_el": "Κείμενο → Video: LTX-Video 2B — Πολύ γρήγορο",
  "name_en": "Text → Video: LTX-Video 2B — Very fast",
  "desc_el": "Μικρό, πολύ γρήγορο μοντέλο (ποιότητα χαμηλότερη από το Wan). Τρέχει σε GPU 12-16 GB. Χρειάζεται το «LTX-Video 2B» εγκατεστημένο.",
  "desc_en": "Small, very fast model (lower quality than Wan). Runs on 12-16 GB GPUs. Needs “LTX-Video 2B” installed.",
  "kind": "t2v",
  "models": [
   "ltx-video-2b-v0.9.5",
   "t5xxl_fp8_e4m3fn_scaled"
  ],
  "pack": "ltxv-2b",
  "vram_gb": 12,
  "est_sec": 60,
  "inputs": [
   {
    "key": "prompt",
    "type": "text",
    "required": true,
    "label_el": "Prompt",
    "label_en": "Prompt"
   },
   {
    "key": "negative",
    "type": "text",
    "default": "worst quality, inconsistent motion, blurry, jittery, distorted, watermark, text",
    "advanced": true,
    "label_el": "Αρνητικό prompt",
    "label_en": "Negative prompt"
   },
   {
    "key": "width",
    "type": "int",
    "default": 768,
    "min": 256,
    "max": 1280,
    "step": 32,
    "label_el": "Πλάτος",
    "label_en": "Width"
   },
   {
    "key": "height",
    "type": "int",
    "default": 512,
    "min": 256,
    "max": 1280,
    "step": 32,
    "label_el": "Ύψος",
    "label_en": "Height"
   },
   {
    "key": "length",
    "type": "int",
    "default": 97,
    "min": 9,
    "max": 257,
    "step": 8,
    "label_el": "Καρέ (8n+1)",
    "label_en": "Frames (8n+1)"
   },
   {
    "key": "fps",
    "type": "int",
    "default": 24,
    "min": 8,
    "max": 30,
    "label_el": "FPS",
    "label_en": "FPS"
   },
   {
    "key": "seed",
    "type": "seed",
    "default": "__RANDOM_INT__",
    "label_el": "Seed (κενό = τυχαίο)",
    "label_en": "Seed (blank = random)"
   }
  ],
  "priority": 100
 },
 "workflow": {
  "1": {
   "inputs": {
    "ckpt_name": "ltx-video-2b-v0.9.5.safetensors"
   },
   "class_type": "CheckpointLoaderSimple",
   "_meta": {
    "title": "CheckpointLoaderSimple"
   }
  },
  "2": {
   "inputs": {
    "clip_name": "t5xxl_fp8_e4m3fn_scaled.safetensors",
    "type": "ltxv",
    "device": "default"
   },
   "class_type": "CLIPLoader",
   "_meta": {
    "title": "CLIPLoader"
   }
  },
  "3": {
   "inputs": {
    "text": "{{prompt}}",
    "clip": [
     "2",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Positive"
   }
  },
  "4": {
   "inputs": {
    "text": "{{negative}}",
    "clip": [
     "2",
     0
    ]
   },
   "class_type": "CLIPTextEncode",
   "_meta": {
    "title": "Negative"
   }
  },
  "6": {
   "inputs": {
    "width": "{{width}}",
    "height": "{{height}}",
    "length": "{{length}}",
    "batch_size": 1
   },
   "class_type": "EmptyLTXVLatentVideo",
   "_meta": {
    "title": "EmptyLTXVLatentVideo"
   }
  },
  "7": {
   "inputs": {
    "positive": [
     "3",
     0
    ],
    "negative": [
     "4",
     0
    ],
    "frame_rate": "{{fps}}"
   },
   "class_type": "LTXVConditioning",
   "_meta": {
    "title": "LTXVConditioning"
   }
  },
  "8": {
   "inputs": {
    "steps": 30,
    "max_shift": 2.05,
    "base_shift": 0.95,
    "stretch": true,
    "terminal": 0.1,
    "latent": [
     "6",
     0
    ]
   },
   "class_type": "LTXVScheduler",
   "_meta": {
    "title": "LTXVScheduler"
   }
  },
  "9": {
   "inputs": {
    "sampler_name": "euler"
