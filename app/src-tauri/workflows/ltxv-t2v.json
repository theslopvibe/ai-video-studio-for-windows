    "title": "KSamplerSelect"
   }
  },
  "10": {
   "inputs": {
    "noise_seed": "{{seed}}"
   },
   "class_type": "RandomNoise",
   "_meta": {
    "title": "RandomNoise"
   }
  },
  "11": {
   "inputs": {
    "model": [
     "1",
     0
    ],
    "positive": [
     "7",
     0
    ],
    "negative": [
     "7",
     1
    ],
    "cfg": 3.0
   },
   "class_type": "CFGGuider",
   "_meta": {
    "title": "CFGGuider"
   }
  },
  "12": {
   "inputs": {
    "noise": [
     "10",
     0
    ],
    "guider": [
     "11",
     0
    ],
    "sampler": [
     "9",
     0
    ],
    "sigmas": [
     "8",
     0
    ],
    "latent_image": [
     "6",
     0
    ]
   },
   "class_type": "SamplerCustomAdvanced",
   "_meta": {
    "title": "SamplerCustomAdvanced"
   }
  },
  "13": {
   "inputs": {
    "samples": [
     "12",
     0
    ],
    "vae": [
     "1",
     2
    ]
   },
   "class_type": "VAEDecode",
   "_meta": {
    "title": "VAEDecode"
   }
  },
  "14": {
   "inputs": {
    "fps": "{{fps}}",
    "images": [
     "13",
     0
    ]
   },
   "class_type": "CreateVideo",
   "_meta": {
    "title": "CreateVideo"
   }
  },
  "15": {
   "inputs": {
    "filename_prefix": "video/ComfyUI",
    "format": "auto",
    "codec": "auto",
    "video": [
     "14",
     0
    ]
   },
   "class_type": "SaveVideo",
   "_meta": {
    "title": "SaveVideo"
   }
  }
 }
}