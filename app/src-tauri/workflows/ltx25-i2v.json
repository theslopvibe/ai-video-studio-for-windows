{
 "meta": {
  "id": "ltx25-i2v",
  "name_el": "Εικόνα → Video: LTX-2.5 22B με ήχο — Υψηλή ποιότητα",
  "name_en": "Image → Video: LTX-2.5 22B with sound — High quality",
  "desc_el": "Ζωντανεύει μια εικόνα με ήχο (φωνές, θόρυβοι περιβάλλοντος), 24 fps, ~720p. Το prompt να ξεκινά με «Use the provided start image as the first frame.» Βαρύ μοντέλο (22B): θέλει κάρτα 32 GB (η ανάγκη σε VRAM δεν έχει μετρηθεί ακόμα). Χρειάζεται το «LTX-2.5 22B distilled» εγκατεστημένο και ComfyUI 0.32 ή νεότερο.",
  "desc_en": "Brings a picture to life with sound (voices, ambience), 24 fps, ~720p. Start the prompt with “Use the provided start image as the first frame.” Heavy model (22B): wants a 32 GB card (VRAM need not measured yet). Needs “LTX-2.5 22B distilled” installed and ComfyUI 0.32 or newer.",
  "kind": "i2v",
  "models": [
   "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot",
   "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot",
   "ltx-2.5-video-vae-bf16",
   "ltx-2.5-audio-vae-bf16",
   "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0"
  ],
  "pack": "ltx25-22b",
  "vram_gb": 32,
  "est_sec": 120,
  "priority": 40,
  "inputs": [
   {
    "key": "prompt",
    "type": "text",
    "required": true,
    "label_el": "Prompt",
    "label_en": "Prompt"
   },
   {
    "key": "image",
    "type": "image",
    "required": true,
    "label_el": "Εικόνα εκκίνησης (1 εικόνα)",
    "label_en": "Start image (1 image)"
   },
   {
    "key": "negative",
    "type": "text",
    "default": "pc game, console game, video game, cartoon, childish, ugly",
    "advanced": true,
    "label_el": "Αρνητικό prompt",
    "label_en": "Negative prompt"
   },
   {
    "key": "width",
    "type": "int",
    "default": 1280,
    "min": 512,
    "max": 1920,
    "step": 32,
    "label_el": "Πλάτος",
    "label_en": "Width"
   },
   {
    "key": "height",
    "type": "int",
