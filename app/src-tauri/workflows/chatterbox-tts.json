 "workflow": {
  "1": {
   "class_type": "FL_ChatterboxMultilingualTTS",
   "inputs": {
    "text": "{{prompt}}",
    "language": "{{language}}",
    "exaggeration": 0.5,
    "cfg_weight": 0.5,
    "temperature": 0.8,
    "repetition_penalty": 2.0,
    "min_p": 0.05,
    "top_p": 1.0,
    "seed": "{{seed}}",
    "use_cpu": false,
    "keep_model_loaded": false
   }
  },
  "2": {
   "class_type": "SaveAudioMP3",
   "inputs": {
    "audio": [
     "1",
     0
    ],
    "filename_prefix": "audio/tts",
    "quality": "V0"
   }
  }
 }
