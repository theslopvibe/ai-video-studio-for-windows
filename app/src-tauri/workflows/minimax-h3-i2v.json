{
 "meta": {
  "id": "minimax-h3-i2v",
  "name_el": "Εικόνα → Video: MiniMax H3 με ήχο",
  "name_en": "Image → Video: MiniMax H3 with sound",
  "desc_el": "Ζωντανεύει μια εικόνα (πρώτο καρέ) με ήχο, 24 fps, 5-15 s. Πολύ βαρύ και αργό μοντέλο (20 βήματα): θέλει κάρτα 32 GB, ο χρόνος και η VRAM δεν έχουν μετρηθεί ακόμα. Χρειάζεται το «MiniMax H3» εγκατεστημένο και ComfyUI 0.30 ή νεότερο.",
  "desc_en": "Brings a picture (first frame) to life with sound, 24 fps, 5-15 s. Very heavy and slow model (20 steps): wants a 32 GB card, time and VRAM not measured yet. Needs “MiniMax H3” installed and ComfyUI 0.30 or newer.",
  "kind": "i2v",
  "models": [
   "minimax_h3_fl2va_pruned_int8_convrot",
   "qwen3vl_32b_minimax_h3_nvfp4_awq",
   "minimax_h3_video_vae_fp16",
   "minimax_h3_audio_vae_fp32"
  ],
  "pack": "minimax-h3",
  "vram_gb": 32,
  "est_sec": 300,
  "priority": 50,
  "inputs": [
   {
    "key": "prompt",
    "type": "text",
    "required": true,
    "label_el": "Prompt",
    "label_en": "Prompt"
   },
   {
    "key": "image",
    "type": "image",
    "required": true,
    "label_el": "Εικόνα εκκίνησης (1 εικόνα)",
    "label_en": "Start image (1 image)"
   },
   {
    "key": "megapixels",
    "type": "float",
    "default": 0.4,
    "min": 0.2,
    "max": 1.0,
    "step": 0.05,
    "label_el": "Ανάλυση (megapixels, κρατά το σχήμα της εικόνας)",
    "label_en": "Resolution (megapixels, keeps the picture's shape)"
   },
   {
    "key": "duration",
    "type": "int",
    "default": 5,
    "min": 5,
    "max": 15,
    "step": 1,
    "label_el": "Διάρκεια (δευτερόλεπτα, 5-15)",
    "label_en": "Duration (seconds, 5-15)"
   },
   {
    "key": "seed",
    "type": "seed",
    "default": "__RANDOM_INT__",
    "label_el": "Seed (κενό = τυχαίο)",
    "label_en": "Seed (blank = random)"
   }
  ]
 },
 "workflow": {
  "1": {
   "inputs": {
    "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
    "weight_dtype": "default"
   },
   "class_type": "UNETLoader",
   "_meta": {
    "title": "UNETLoader"
   }
  },
  "2": {
   "inputs": {
    "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
    "type": "minimax",
    "device": "default"
   },
   "class_type": "CLIPLoader",
   "_meta": {
    "title": "CLIPLoader"
   }
  },
  "3": {
   "inputs": {
    "vae_name": "minimax_h3_video_vae_fp16.safetensors"
   },
   "class_type": "VAELoader",
   "_meta": {
    "title": "Video VAE"
   }
  },
  "4": {
   "inputs": {
    "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
   },
   "class_type": "VAELoader",
   "_meta": {
    "title": "Audio VAE"
   }
  },
  "5": {
   "inputs": {
    "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
    "values.a": "{{duration}}"
   },
   "class_type": "ComfyMathExpression",
   "_meta": {
    "title": "Frames (17k+5 grid, 24 fps)"
   }
  },
  "6": {
   "inputs": {
    "clip": [
     "2",
     0
    ],
    "vae": [
     "3",
     0
    ],
    "prompt": "{{prompt}}",
    "length": [
     "5",
     1
    ],
    "width": [
     "22",
     0
    ],
    "height": [
     "22",
     1
    ],
    "first_frame": [
     "21",
     0
    ]
   },
   "class_type": "MiniMaxH3ImageToVideo",
   "_meta": {
    "title": "MiniMaxH3ImageToVideo"
   }
  },
  "7": {
   "inputs": {
    "noise_seed": "{{seed}}"
   },
   "class_type": "RandomNoise",
   "_meta": {
    "title": "RandomNoise"
   }
  },
  "8": {
   "inputs": {
    "sampler_name": "res_multistep"
   },
   "class_type": "KSamplerSelect",
   "_meta": {
    "title": "KSamplerSelect"
   }
  },
  "9": {
   "inputs": {
    "model": [
     "1",
     0
    ],
    "scheduler": "simple",
    "steps": 20,
    "denoise": 1.0
   },
   "class_type": "BasicScheduler",
   "_meta": {
    "title": "BasicScheduler"
   }
  },
  "10": {
   "inputs": {
    "model": [
     "1",
     0
    ],
    "conditioning": [
     "6",
     0
    ]
   },
   "class_type": "BasicGuider",
   "_meta": {
    "title": "BasicGuider"
   }
  },
  "11": {
   "inputs": {
    "noise": [
     "7",
     0
    ],
    "guider": [
     "10",
     0
    ],
    "sampler": [
     "8",
     0
    ],
    "sigmas": [
     "9",
     0
    ],
    "latent_image": [
     "6",
     1
    ]
   },
   "class_type": "SamplerCustomAdvanced",
   "_meta": {
    "title": "SamplerCustomAdvanced"
   }
  },
  "12": {
   "inputs": {
    "samples": [
     "11",
     0
    ],
    "vae": [
     "3",
     0
    ]
   },
   "class_type": "VAEDecode",
   "_meta": {
    "title": "VAEDecode"
   }
  },
  "13": {
   "inputs": {
    "samples": [
     "11",
     0
    ],
    "vae": [
     "4",
     0
    ]
   },
   "class_type": "VAEDecodeAudio",
   "_meta": {
    "title": "VAEDecodeAudio"
   }
  },
  "14": {
   "inputs": {
    "images": [
     "12",
     0
    ],
    "audio": [
     "13",
     0
    ],
    "fps": 24.0
   },
   "class_type": "CreateVideo",
   "_meta": {
    "title": "CreateVideo"
   }
  },
  "15": {
   "inputs": {
    "filename_prefix": "video/ComfyUI",
    "format": "auto",
    "codec": "auto",
    "video": [
     "14",
     0
    ]
   },
   "class_type": "SaveVideo",
   "_meta": {
    "title": "SaveVideo"
   }
  },
  "20": {
   "inputs": {
    "image_b64": "{{image}}"
   },
   "class_type": "AIVSLoadImageBase64",
   "_meta": {
    "title": "Start image"
   }
  },
  "21": {
   "inputs": {
    "upscale_method": "lanczos",
    "image": [
     "20",
     0
    ],
    "megapixels": "{{megapixels}}",
    "resolution_steps": 32
   },
   "class_type": "ImageScaleToTotalPixels",
   "_meta": {
    "title": "ImageScaleToTotalPixels"
   }
  },
  "22": {
   "inputs": {
    "image": [
     "21",
     0
    ]
   },
   "class_type": "GetImageSize",
   "_meta": {
    "title": "GetImageSize"
   }
  }
 }
}
