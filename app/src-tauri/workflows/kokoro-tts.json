   }
  },
  "2": {
   "class_type": "KokoroGenerator",
   "inputs": {
    "text": "{{prompt}}",
    "speaker": [
     "1",
     0
    ],
    "speed": "{{speed}}",
    "lang": "{{language}}"
   }
  },
