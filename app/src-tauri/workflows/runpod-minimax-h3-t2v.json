{
  "meta": {
    "id": "runpod-minimax-h3-t2v",
    "name_el": "RunPod · Κείμενο → Video: MiniMax H3 με ήχο",
    "name_en": "RunPod · Text → Video: MiniMax H3 with sound",
    "desc_el": "Τρέχει στο RunPod Serverless endpoint σου (τα μοντέλα είναι στον network volume του, η εφαρμογή δεν εγκαθιστά τίποτα). Πληρώνεις ανά δευτερόλεπτο GPU, περίπου $0.10 ανά αποτέλεσμα.",
    "desc_en": "Runs on your RunPod Serverless endpoint (models live on its network volume, nothing is installed by the app). Pay per second of GPU time, about $0.10 per result (MiniMax H3 with sound, time estimated (not measured)).",
    "kind": "t2v",
    "models": [],
    "pack": "",
    "vram_gb": 48,
    "est_sec": 600,
    "priority": 164,
    "inputs": [
      {
        "key": "prompt",
        "type": "text",
        "required": true,
        "label_el": "Prompt",
        "label_en": "Prompt"
      },
      {
        "key": "width",
        "type": "int",
        "default": 864,
        "min": 320,
        "max": 1344,
        "step": 32,
        "label_el": "Πλάτος",
        "label_en": "Width"
      },
      {
        "key": "height",
        "type": "int",
        "default": 480,
        "min": 320,
        "max": 1344,
        "step": 32,
        "label_el": "Ύψος",
        "label_en": "Height"
      },
      {
        "key": "duration",
        "type": "int",
        "default": 5,
        "min": 5,
        "max": 15,
        "step": 1,
        "label_el": "Διάρκεια (δευτερόλεπτα, 5-15)",
        "label_en": "Duration (seconds, 5-15)"
      },
      {
        "key": "seed",
        "type": "seed",
        "default": "__RANDOM_INT__",
        "label_el": "Seed (κενό = τυχαίο)",
        "label_en": "Seed (blank = random)"
      }
    ],
    "provider": "runpod",
    "model": "",
    "request": {},
    "est_usd": 0.2,
    "license": "paid"
  },
  "workflow": {
    "1": {
      "inputs": {
        "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "UNETLoader"
      }
    },
    "2": {
      "inputs": {
        "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "type": "minimax",
        "device": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": {
        "title": "CLIPLoader"
      }
    },
    "3": {
      "inputs": {
        "vae_name": "minimax_h3_video_vae_fp16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Video VAE"
      }
    },
    "4": {
      "inputs": {
        "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Audio VAE"
      }
    },
    "5": {
      "inputs": {
        "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
        "values.a": "{{duration}}"
      },
      "class_type": "ComfyMathExpression",
      "_meta": {
        "title": "Frames (17k+5 grid, 24 fps)"
      }
    },
    "6": {
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "prompt": "{{prompt}}",
        "length": [
          "5",
          1
        ],
        "width": "{{width}}",
        "height": "{{height}}"
      },
      "class_type": "MiniMaxH3ImageToVideo",
      "_meta": {
        "title": "MiniMaxH3ImageToVideo"
      }
    },
    "7": {
      "inputs": {
        "noise_seed": "{{seed}}"
      },
      "class_type": "RandomNoise",
      "_meta": {
        "title": "RandomNoise"
      }
    },
    "8": {
      "inputs": {
        "sampler_name": "res_multistep"
      },
      "class_type": "KSamplerSelect",
      "_meta": {
        "title": "KSamplerSelect"
      }
    },
    "9": {
      "inputs": {
        "model": [
          "1",
          0
        ],
        "scheduler": "simple",
        "steps": 20,
        "denoise": 1.0
      },
      "class_type": "BasicScheduler",
      "_meta": {
        "title": "BasicScheduler"
      }
    },
    "10": {
      "inputs": {
        "model": [
          "1",
          0
        ],
        "conditioning": [
          "6",
          0
        ]
      },
      "class_type": "BasicGuider",
      "_meta": {
        "title": "BasicGuider"
      }
    },
    "11": {
      "inputs": {
        "noise": [
          "7",
          0
        ],
        "guider": [
          "10",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9",
          0
        ],
        "latent_image": [
          "6",
          1
        ]
      },
      "class_type": "SamplerCustomAdvanced",
      "_meta": {
        "title": "SamplerCustomAdvanced"
      }
    },
    "12": {
      "inputs": {
        "samples": [
          "11",
          0
        ],
        "vae": [
          "3",
          0
        ]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAEDecode"
      }
    },
    "13": {
      "inputs": {
        "samples": [
          "11",
          0
        ],
        "vae": [
          "4",
          0
        ]
      },
      "class_type": "VAEDecodeAudio",
      "_meta": {
        "title": "VAEDecodeAudio"
      }
    },
    "14": {
      "inputs": {
        "images": [
          "12",
          0
        ],
        "audio": [
          "13",
          0
        ],
        "fps": 24.0
      },
      "class_type": "CreateVideo",
      "_meta": {
        "title": "CreateVideo"
      }
    },
    "15": {
      "inputs": {
        "filename_prefix": "video/ComfyUI",
        "format": "auto",
        "codec": "auto",
        "video": [
          "14",
          0
        ]
      },
      "class_type": "SaveVideo",
      "_meta": {
        "title": "SaveVideo"
      }
    }
  }
}
