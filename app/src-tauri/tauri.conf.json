{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Video Studio For Windows",
  "version": "0.9.9",
  "identifier": "com.aivideostudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Video Studio For Windows",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "workflows/*": "workflows/",
      "editor-dist": "editor",
      "paint-dist": "paint",
      "../../mcp/ai-video-studio.mcpb": "connect/ai-video-studio.mcpb",
      "../../mcp/Connect-Claude.bat": "connect/Connect-Claude.bat",
      "../../mcp/Connect-Claude.ps1": "connect/Connect-Claude.ps1",
      "../../mcp/Connect-ZCode.bat": "connect/Connect-ZCode.bat",
      "../../mcp/Connect-ZCode.ps1": "connect/Connect-ZCode.ps1"
    },
    "shortDescription": "Free open-source AI video and image studio",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "English",
          "Greek"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMEY2RDU1NzkzNDU5MzYKUldRMldUUjVWVzBQekxDeTMwejA2RUdDeUwzZWJMNWRFY1p5dEljLzUvNmdtUlNzL0xmTWh3WHMK",
      "endpoints": ["https://github.com/theslopvibe/ai-video-studio-for-windows/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
