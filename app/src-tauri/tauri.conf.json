{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Video Studio For Windows",
  "version": "0.3.0",
  "identifier": "com.aivideostudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Video Studio For Windows",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0e1014"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "workflows/*": "workflows/",
      "editor-dist": "editor"
    },
    "shortDescription": "Free open-source AI video and image studio",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "English",
          "Greek"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
